# ============================================================
# FRONTEND ENVIRONMENT VARIABLES (.env)
# Copy to .env and fill in your values.
# NONE of these are secrets — safe to expose in the browser bundle.
# All AI/TTS API keys belong in mcp-server/.env (server-side only).
# ============================================================

# Backend API base URL (Railway in production, localhost in dev)
VITE_API_URL=https://enquest3k.up.railway.app/api

# Cloudflare R2 public CDN for audio assets
VITE_CDN_URL=https://pub-8f917d02000c4be2a7214afb8d12abd3.r2.dev

# Cloudflare R2 public CDN for image assets (separate bucket)
VITE_IMAGES_CDN_URL=https://pub-6b5486dcbb554a6694b6c7032a43dcae.r2.dev

# Kokoro TTS — Hugging Face Space endpoint
VITE_EDGE_TTS_URL=https://binh3k-engquest3k.hf.space

# Cloudflare TTS Worker (optional — bypasses HF cold starts)
VITE_TTS_WORKER_URL=https://engquest-tts-worker.yourworker.workers.dev

# ⚠️  DO NOT ADD AI API KEYS HERE — they go in mcp-server/.env
# VITE_ variables are bundled into the browser and visible to everyone.
