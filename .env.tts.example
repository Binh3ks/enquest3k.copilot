# TTS Service Configuration
# Copy to .env or .env.production

# ====================================
# CDN Configuration (Cloudflare R2)
# ====================================

# CDN base URL for pre-generated Kokoro TTS files
# Used for weeks 1-7 static content (shadowing, dictation, vocab, etc.)
# After R2 upload and custom domain setup, use:
VITE_CDN_URL=https://cdn.bkbacademy.vn/tts

# Development (before CDN setup):
# VITE_CDN_URL=http://localhost:5173/audio_kokoro


# ====================================
# Edge TTS Configuration (Fallback)
# ====================================

# Edge TTS server URL for dynamic content and CDN fallback
# Options:
# 1. Local Kokoro server (best for development):
VITE_EDGE_TTS_URL=http://localhost:8000

# 2. HF Spaces FREE (has cold start, but $0 cost):
# VITE_EDGE_TTS_URL=https://binh3k-engquest3k.hf.space

# 3. HF Spaces with Persistent (no cold start, $5/month):
# VITE_EDGE_TTS_URL=https://binh3k-engquest3k.hf.space

# 4. Modal.com serverless (best performance, ~$2.50/month):
# VITE_EDGE_TTS_URL=https://engquest-tts.modal.run


# ====================================
# Week Coverage Configuration
# ====================================

# Which weeks have pre-generated files on CDN?
# Currently: Weeks 1-7 (both EASY and ADVANCED modes)
# Update this as you generate more weeks
# Note: This is configured in voiceService.js:
#   const CDN_WEEKS = [1, 2, 3, 4, 5, 6, 7];


# ====================================
# Development Notes
# ====================================

# Local testing without CDN:
# 1. Set VITE_CDN_URL to local folder
# 2. After generation, files will be in: public/audio_kokoro/
# 3. Vite will serve them as static assets
# 4. Test URLs: http://localhost:5173/audio_kokoro/week1/shadowing_1.mp3

# Production setup:
# 1. Generate audio files: python3 tools/generate_kokoro_batch.py
# 2. Upload to R2: bash tools/upload_to_r2.sh
# 3. Configure custom domain: cdn.bkbacademy.vn → R2 bucket
# 4. Update VITE_CDN_URL to production CDN URL
# 5. Rebuild: npm run build
# 6. Deploy to production


# ====================================
# Performance Targets
# ====================================

# CDN Response Time: <100ms (weeks 1-7 static content)
# Edge TTS Time: 1-2s (dynamic content, fallback)
# Browser TTS Time: ~500ms (last resort)
# Cache Hit Rate: >90% (after first visit)


# ====================================
# Cost Estimates
# ====================================

# CDN (Cloudflare R2): ~$0.50/month
# Edge TTS Server:
#   - Local: $0 (your computer)
#   - HF Spaces FREE: $0 (cold start issues)
#   - HF Spaces Persistent: $5/month
#   - Modal.com: ~$2.50/month (pay-per-use)
# Browser TTS: $0 (built-in)
#
# Recommended: CDN + Modal.com = $3/month total
