# ============================================================
# BACKEND ENVIRONMENT VARIABLES (mcp-server/.env)
# Copy to mcp-server/.env and fill in your values.
# These are SECRET — never commit .env to git.
# ============================================================

# --- PostgreSQL Connection ---
PG_USER=your_db_user
PG_HOST=localhost
PG_DATABASE=engquest_db
PG_PASSWORD=your_db_password
PG_PORT=5432

# --- Application Settings ---
PORT=5001

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# --- AI Providers (server-side only — NEVER expose to frontend) ---
# Priority order: Cerebras → Groq → Together → Gemini (auto-failover)

# Cerebras (fastest, primary)
CEREBRAS_API_KEY=

# Groq (fast, free tier available)
GROQ_API_KEY=

# Together AI (fallback)
TOGETHER_API_KEY=

# Google Gemini (final fallback)
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP_1=
GEMINI_API_KEY_BACKUP_2=

# OpenAI (for TTS via /api/ai/tts)
OPENAI_API_KEY=

# Google Cloud TTS (for /api/ai/google-tts)
GOOGLE_TTS_API_KEY=

# Deepgram (for pronunciation STT - Speech-to-Text)
DEEPGRAM_API_KEY=

# --- Cloudflare R2 (for audio/image uploads) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=engquest-audio
R2_CDN_URL=https://pub-8f917d02000c4be2a7214afb8d12abd3.r2.dev
