# Never cache the HTML entry point — ensures browser always gets latest JS chunk names
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  CDN-Cache-Control: no-store
  Surrogate-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

# Cache hashed assets forever (filename changes on every build)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Main entry file has NO hash — must never be cached (overrides /assets/* rule above)
/assets/index.js
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

# Service worker must never be cached
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
