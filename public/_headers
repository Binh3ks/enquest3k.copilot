# Never cache the HTML entry point — ensures browser always gets latest JS chunk names
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Cache hashed assets forever (filename changes on every build)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker must never be cached
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
