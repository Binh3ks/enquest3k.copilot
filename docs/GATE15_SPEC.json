{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gate 15 Production DOM Assertions Spec",
  "version": "2.3.0",
  "week": 34,
  "global_negative_patterns": [
    "corridor", "Corridor", "Jake", "friction", "Friction",
    "nurse", "Nurse", "wet floor", "slipped", "Total Corridor",
    "Object 1", "Object 2", "data not found", "Symbiosis",
    "Physics & Forces", "Physics & Friction", "Dry Surfaces",
    "walking carefully", "moving forward", "during the journey",
    "stopped immediately", "needed urgent help", "was patrolling", "caught 24 fish"
  ],
  "quests": {
    "gear1_webtoon": {
      "waitMs": 3000,
      "clickStart": false,
      "neg": [],
      "pos": [
        {
          "name": "W34 blueprint keyword in DOM (lion OR mouse)",
          "type": "contains_one_of",
          "values": ["lion", "mouse"],
          "case_sensitive": false
        },
        {
          "name": "3 pins mini-game present (Found indicator)",
          "type": "contains_one_of",
          "values": ["0/3", "Found", "🔍", "hidden", "pin"],
          "case_sensitive": false
        }
      ]
    },
    "gear2_karaoke": {
      "waitMs": 1500,
      "clickStart": false,
      "neg": [],
      "pos": [
        {
          "name": "karaoke/shadowing blueprint keyword present",
          "type": "contains_one_of",
          "values": ["lion", "mouse", "forest", "net", "rope", "hunter", "brave"],
          "case_sensitive": false
        }
      ]
    },
    "gear3_retell": {
      "waitMs": 1500,
      "clickStart": false,
      "neg": [],
      "pos": [
        {
          "name": "retell blueprint keyword present",
          "type": "contains_one_of",
          "values": ["lion", "mouse", "forest", "net", "rope", "hunter", "brave"],
          "case_sensitive": false
        }
      ]
    },
    "gear4_clil": {
      "waitMs": 1500,
      "clickStart": false,
      "neg": [],
      "pos": [
        {
          "name": "part title contains Animal/Forest/Cooperation/Seed (NOT Friction/Dry Surfaces)",
          "type": "regex",
          "pattern": "(Animal|Forest|Cooperation|Seed|animal|forest|cooperation|seed)"
        },
        {
          "name": "banned friction labels absent",
          "type": "not_contains_regex",
          "pattern": "(friction|Friction|Dry Surfaces|Water on the Floor)"
        },
        {
          "name": "Vocab Focus button clicked reveals >=5 vocab pills",
          "type": "interaction_check",
          "action": "click",
          "selector": "button:has-text('Vocab Focus')",
          "wait_after_ms": 1000,
          "assertion": {
            "type": "regex_min_count",
            "pattern": "\\b(forest|squirrel|jay|nectar|pollen|seed|grow|plants|flowers|helpers|safe|homes|green|strong|travel|lion|mouse)\\b",
            "min": 5,
            "case_sensitive": false
          }
        },
        {
          "name": "Grammar X-Ray inline: >=3 highlight marks INSIDE paragraph",
          "type": "dom_count",
          "selector": "p mark, p span[class*='amber'], p span[class*='highlight']",
          "min": 3
        },
        {
          "name": "CLIL glossary chips rendered (>=3)",
          "type": "dom_count",
          "selector": "[data-testid='clil-glossary-chip']",
          "min": 3
        }
      ]
    },
    "science_lab": {
      "waitMs": 1500,
      "clickStart": true,
      "clickText": "START",
      "neg": [],
      "pos": [
        {
          "name": "lab title contains Animal/Cooperation/Ecosystem (NOT Friction/Physics)",
          "type": "regex",
          "pattern": "(Animal|animal|Lion|lion|Cooperation|cooperation|Ecosystem)"
        },
        {
          "name": ">=2 themed label pills present after START",
          "type": "contains_min_count",
          "values": ["Lion", "Mouse", "Forest Trees", "Warning Birds", "Forest", "guards", "cleans", "gives", "chirps", "food", "danger", "seeds", "warnings"],
          "min": 2,
          "case_sensitive": false
        }
      ]
    },
    "science_report": {
      "waitMs": 1500,
      "clickStart": false,
      "neg": [],
      "pos": [
        {
          "name": "title Seed Helpers / Animal Cooperation in Nature (NOT corridor/friction)",
          "type": "regex",
          "pattern": "(Seed|Animal|Cooperation|seed|animal|cooperation|Plants)"
        },
        {
          "name": "CLIL Data Card 3 rows present",
          "type": "regex",
          "pattern": "(CLIL Data Card|3 Key Facts|Data Card)"
        },
        {
          "name": "3 steps present (Observation/Scientific/Conclusion)",
          "type": "regex_all",
          "patterns": [
            "(Observation|Observe|Observe Animal|Step 1|1\\.)",
            "(Scientific|Measure|Mutual|Step 2|2\\.)",
            "(Conclusion|Record|Result|Step 3|3\\.)"
          ]
        },
        {
          "name": "science_report pills reuse >=2 keywords from CLIL facts",
          "type": "keyword_overlap",
          "source_quest": "gear4_clil",
          "min_overlap": 2
        }
      ]
    },
    "word_blitz": {
      "waitMs": 1500,
      "clickStart": true,
      "clickText": "START",
      "neg": [],
      "pos": [
        {
          "name": ">=4 W34 blueprint words present",
          "type": "contains_min_count",
          "values": ["lion", "mouse", "net", "rope", "forest", "hunter", "trapped", "freed", "brave", "tiny", "grateful", "sleeping", "mighty", "promise", "chewed"],
          "min": 4,
          "case_sensitive": false
        }
      ]
    },
    "sentence_smash": {
      "waitMs": 1500,
      "clickStart": true,
      "clickText": "START",
      "neg": [],
      "pos": [
        {
          "name": "grammar drill tiles contain >=2 W34 blueprint keywords",
          "type": "contains_min_count",
          "values": ["lion", "mouse", "hunter", "rope", "forest", "brave", "sleeping", "while", "trapped", "chewed"],
          "min": 2,
          "case_sensitive": false
        }
      ]
    },
    "math_quest": {
      "waitMs": 1500,
      "clickStart": true,
      "clickText": "START",
      "neg": ["monkey", "corridor", "Corridor", "Jake", "friction", "slipped", "nurse", "wet floor", "walked"],
      "pos": [
        {
          "name": "Bar Model UI rendered",
          "type": "regex",
          "pattern": "(PROBLEM|Problem|Bar Model|Singapore|bar model|parts?|total|answer)"
        },
        {
          "name": "math problem text contains W34 blueprint keywords",
          "type": "regex",
          "pattern": "(lion|mouse|forest|net|rope|hunter|trapped|freed|brave|mighty|tiny)"
        },
        {
          "name": "problem numbers overlap bar model (>=2 shared integers)",
          "type": "numbers_overlap",
          "min": 2
        }
      ]
    },
    "story_writer": {
      "waitMs": 2500,
      "clickStart": false,
      "neg": ["In the morning,", "was walking carefully"],
      "pos": [
        {
          "name": "step wizard: đúng 1 <img> scene + indicator 'Scene X of 3'",
          "type": "regex",
          "pattern": "(Scene 1 of 3|Scene \\d+ of 3|Panel \\d+ of 3)"
        },
        {
          "name": "story writer interface loaded with W34 content",
          "type": "contains_one_of",
          "values": ["Scene", "Story", "Write", "lion", "mouse", "net", "ropes", "forest"],
          "case_sensitive": false
        },
        {
          "name": "chunks themed (>=2 W34 pill strings in DOM)",
          "type": "contains_min_count",
          "values": [
            "the mighty lion", "was sleeping peacefully", "under a tall oak tree", "in the forest",
            "hunters trapped the lion", "in a heavy net", "chewed the thick ropes", "freed the mighty lion", "loyal friends"
          ],
          "min": 2,
          "case_sensitive": false
        }
      ]
    },
    "broadcast_studio": {
      "waitMs": 2000,
      "clickStart": false,
      "neg": [],
      "pos": [
        {
          "name": "video recording interface loaded",
          "type": "regex",
          "pattern": "(Record|record|Camera|camera|Video Challenge|broadcast|Podcast|retell|RETELL)"
        },
        {
          "name": "W34 blueprint keyword OR story context",
          "type": "regex",
          "pattern": "(lion|mouse|forest|net|rope|hunter|brave|retell|retelling|story|scene)"
        }
      ]
    },
    "info_exchange": {
      "waitMs": 2000,
      "clickStart": false,
      "neg": ["data not found"],
      "pos": [
        {
          "name": "cue card exchange UI loaded with W34 content",
          "type": "regex",
          "pattern": "(lion|mouse|Lion|Mouse|Forest|forest|Animal Shelter|Green Valley|Oak Tree|Rope|mighty|brave|Mighty|Brave|wilderness|freshwater)"
        },
        {
          "name": "cue rows have actual text (NOT empty '01. ? 02. ? 03. ?')",
          "type": "not_contains_regex",
          "pattern": "01\\.\\s*\\?\\s*02\\.\\s*\\?\\s*03\\.\\s*\\?"
        },
        {
          "name": "at least 3 cue text strings >=10 chars each",
          "type": "regex_min_count",
          "pattern": "\\b[A-Za-z][a-z]{9,}\\b",
          "min": 3
        },
        {
          "name": "Table B has >=3 examiner audio buttons",
          "type": "dom_count",
          "selector": "[data-testid='ie-audio-btn']",
          "min": 3
        }
      ]
    },
    "boss_listening": {
      "waitMs": 1500,
      "clickStart": true,
      "clickText": "ENTER BOSS BATTLE NOW",
      "neg": [],
      "pos": [
        {
          "name": "exam header Cambridge A2 Flyers",
          "type": "regex",
          "pattern": "Cambridge A2 Flyers — "
        },
        {
          "name": "header shows correct Cycle 2 task (Part 4 or Part 5)",
          "type": "regex",
          "pattern": "(Part 4|Part 5|PART 4|PART 5|3-Picture|Color.*Write|Write.*Color|QUIZ|Quiz)"
        },
        {
          "name": "official Cambridge listening instruction sentence",
          "type": "regex",
          "pattern": "(Listen and tick the box|Listen and colour and write|Listen and draw lines|Listen and write|Listen and write a letter)"
        },
        {
          "name": "exam intro audio button present",
          "type": "dom_count",
          "selector": "[data-testid='exam-intro-audio']",
          "min": 1
        },
        {
          "name": "object labels themed (NO Object N pattern)",
          "type": "not_contains_regex",
          "pattern": "\\bObject\\s+\\d+\\b"
        }
      ]
    },
    "boss_reading": {
      "waitMs": 1500,
      "clickStart": true,
      "clickText": "ENTER BOSS BATTLE NOW",
      "neg": ["MAGIC COLOR", "Color Mission", "Color Write", "Part 5", "PART 5"],
      "pos": [
        {
          "name": "exam header Cambridge A2 Flyers",
          "type": "regex",
          "pattern": "Cambridge A2 Flyers — "
        },
        {
          "name": "Cycle 2 boss_reading MUST render Word Bank Matching (RW Part 1)",
          "type": "regex",
          "pattern": "(word.*bank|Word Bank|Definition|definition|15-WORD BANK|15 Words|Candidate Words)"
        },
        {
          "name": "official Cambridge reading instruction sentence",
          "type": "regex",
          "pattern": "(Look and read|Read the text|Read the conversation|Read the story|Look at the picture and read the story|Read the diary|Write about this story)"
        }
      ]
    },
    "weekly_review": {
      "waitMs": 1500,
      "clickStart": true,
      "clickText": "ENTER BOSS BATTLE NOW",
      "neg": ["word bank", "Word Bank", "Definition", "definition", "15-WORD", "Candidate Words"],
      "pos": [
        {
          "name": "Cycle 2 weekly_review MUST be Speaking/Passport task",
          "type": "regex",
          "pattern": "(Speaking|speaking|Passport|passport|PASSPORT|Review|review|Find Differences|Picture Story|Personal Questions|Cambridge A2 Flyers)"
        },
        {
          "name": "official Cambridge speaking/review instruction sentence",
          "type": "regex",
          "pattern": "(Look at the two pictures|Ask and answer questions|Look at the pictures|Now let's talk about you|Tell me the differences)"
        },
        {
          "name": "exam intro audio button present",
          "type": "dom_count",
          "selector": "[data-testid='exam-intro-audio']",
          "min": 1
        },
        {
          "name": "hotspot click-test: click 4 regions reveals 'Found 4 of 4'",
          "type": "click_test_hotspots"
        },
        {
          "name": "hotspot calibration file: 4 mapped regions",
          "type": "file_check",
          "path": "docs/week34_hotspot_calibration.json",
          "require": "\"mapped\": 4"
        }
      ]
    }
  },
  "data_consistency": [
    {
      "name": "listening_hub.singapore_math[i].problem_en === singapore_math.js problems[i].problemText (i=1..5)",
      "type": "file_equality",
      "a": "listening_hub.singapore_math[i].problem_en",
      "b": "singapore_math.js problems[i].problemText"
    },
    {
      "name": "speaking_hub.js info_exchange_cards.examiner_questions audio_url exists",
      "type": "field_exists",
      "file": "speaking_hub.js",
      "path": "info_exchange_cards.examiner_questions[0..2].audio_url"
    },
    {
      "name": "writing_hub.js writing_chunks exists",
      "type": "field_exists",
      "file": "writing_hub.js",
      "path": "writing_chunks"
    }
  ]
}
